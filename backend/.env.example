# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/researchhub-ai

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - leave blank to use mock/console email in dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ResearchHub AI <no-reply@researchhub.ai>

# AI (optional - falls back to mock AI if not provided)
OPENAI_API_KEY=
USE_MOCK_AI=true

# Frontend URL (for CORS + email links)
CLIENT_URL=http://localhost:5173
